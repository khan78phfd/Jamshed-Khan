<section class="custom-banner" data-section-id="{{ section.id }}">
  <div class="banner-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    <div class="banner-buttons">
      <a href="{{ section.settings.primary_link }}" class="btn primary">
        {{ section.settings.primary_text }}
      </a>
      <a href="{{ section.settings.secondary_link }}" class="btn secondary">
        {{ section.settings.secondary_text }}
      </a>
    </div>
  </div>
</section>

<style>
.custom-banner {
  padding: 80px 20px;
  text-align: center;
}
.banner-content h1 {
  font-size: 40px;
}
.banner-content p {
  color: #666;
  margin: 12px 0 24px;
}
.btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 8px;
  text-decoration: none;
  transition: transform .2s ease, box-shadow .2s ease;
}
.btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 20px rgba(0,0,0,.1);
}
.primary {
  background: #ff4d4f;
  color: #fff;
}
.secondary {
  border: 2px solid #ff4d4f;
  color: #ff4d4f;
}
@media (max-width: 600px) {
  .banner-content h1 { font-size: 28px; }
}
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Winter Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Designed for comfort" },
    { "type": "text", "id": "primary_text", "label": "Primary Button Text", "default": "Shop Now" },
    { "type": "url", "id": "primary_link", "label": "Primary Button Link" },
    { "type": "text", "id": "secondary_text", "label": "Secondary Button Text", "default": "Learn More" },
    { "type": "url", "id": "secondary_link", "label": "Secondary Button Link" }
  ],
  "presets": [
    { "name": "Custom Banner" }
  ]
}
{% endschema %}
